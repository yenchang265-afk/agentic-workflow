{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-command.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-verdict-guard.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-stage-guard.mjs\""
          }
        ]
      },
      {
        "_comment": "Separate from the guard above, and deliberately non-overlapping with it: no alternative in that matcher is a substring of Agent or Task, so no call is ever seen by both hooks. Two PreToolUse hooks returning updatedInput for the same call is undocumented behaviour. The split also keeps the policies apart — the guard fails CLOSED on an unknown host, this one fails OPEN.",
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stamp-spawn-model.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-ado-pat.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reconcile.mjs\""
          }
        ]
      }
    ]
  }
}
