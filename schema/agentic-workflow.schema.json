      "type": "string"
    },
    "maxIterations": {
      "default": 3,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tasksDir": {
      "default": "docs/tasks",
      "type": "string",
      "minLength": 1
    },
    "ignoreBacklog": {
      "default": true,
      "type": "boolean"
    },
    "stageTimeoutMinutes": {
      "default": 60,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "checkTimeoutMinutes": {
      "default": 10,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
