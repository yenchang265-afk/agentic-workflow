{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yenchang265-afk/agentic-workflow/schema/agentic-workflow.schema.json",
  "title": ".agentic-workflow.json",
  "description": "Configuration for the agentic-workflow loop and sitters. Every field has a default; refinements the runtime enforces (e.g. codePlatform 'ado' requires an ado section) are not expressed here.",
