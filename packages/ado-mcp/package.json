{
  "name": "@agentic-workflow/ado-mcp",
  "version": "0.0.1",
  "description": "Azure DevOps MCP client backing the core AdoGateway port — the only client-side @modelcontextprotocol/sdk consumer in the repo",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@agentic-workflow/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}
