{
  // tsconfig.json doubles as the build config (outDir/rootDir), so it excludes
  // *.test.ts to keep tests out of dist/ — which also leaves them unchecked, as
  // the runner is tsx and strips types without checking them. Same file, same
  // rationale, as packages/core/tsconfig.test.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
