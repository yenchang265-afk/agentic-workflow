{
  "kind": "dep-sitter",
  "version": 1,
  "description": "Sits on vulnerable and outdated dependencies: confirms the advisory, applies the patch/minor upgrade on a branch, fixes the fallout, verifies the suite is green, and opens a draft PR. Major bumps are never auto-fixed and merging stays a human call.",
  "workSource": {
    "type": "dependency-scan",
    "autoFix": [
      "patch",
      "minor"
    ],
    "severityFloor": "high",
    "includeOutdated": false,
    "ecosystem": "auto"
  },
  "maxIterations": 2,
  "stages": [
    {
      "name": "scan",
      "kind": "check",
      "command": "dep-scan",
      "agent": "workflow-dep-scan",
      "prompt": "stages/scan.md",
      "isolation": "none",
      "bashAllowlist": [
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "npm view *",
        "osv-scanner *",
        "mvn dependency:tree*",
        "mvn help:evaluate*",
        "./mvnw dependency:tree*",
        "./mvnw help:evaluate*",
        "gradle dependencies*",
        "gradle dependencyInsight*",
        "./gradlew dependencies*",
        "./gradlew dependencyInsight*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *"
      ]
    },
    {
      "name": "upgrade",
      "kind": "work",
      "command": "dep-upgrade",
      "agent": "workflow-dep-upgrade",
      "prompt": "stages/upgrade.md",
      "isolation": "worktree"
    },
    {
      "name": "verify",
      "kind": "check",
      "command": "verify",
      "agent": "workflow-verify",
      "prompt": "stages/verify.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "npx prettier*",
        "npx biome*",
        "npx playwright test*",
        "deno check*",
        "deno lint*",
        "deno test*",
        "pytest*",
        "python -m pytest*",
        "python3 -m pytest*",
        "ruff*",
        "mypy*",
        "tox*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run mypy*",
        "poetry run pytest*",
        "poetry run ruff*",
        "poetry run mypy*",
        "go test*",
        "go build*",
        "go vet*",
        "cargo test*",
        "cargo check*",
        "cargo clippy*",
        "cargo build*",
        "dotnet test*",
        "dotnet build*",
        "rspec*",
        "bundle exec rspec*",
        "bundle exec rake*",
        "composer test*",
        "./vendor/bin/phpunit*",
        "make test*",
        "make check*",
        "make build*",
        "make lint*",
        "npm ci*",
        "npm install*",
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "pnpm install*",
        "yarn install*",
        "bun install*",
        "pip install*",
        "python -m pip install*",
        "uv sync*",
        "poetry install*",
        "dotnet restore*",
        "bundle install*",
        "composer install*",
        "osv-scanner *",
        "mvn test*",
        "mvn verify*",
        "mvn dependency:tree*",
        "./mvnw test*",
        "./mvnw verify*",
        "./mvnw dependency:tree*",
        "gradle test*",
        "gradle check*",
        "gradle build*",
        "gradle dependencyInsight*",
        "./gradlew test*",
        "./gradlew check*",
        "./gradlew build*",
        "./gradlew dependencyInsight*",
        "cd * && npm test*",
        "cd * && npm run *",
        "cd * && pnpm test*",
        "cd * && pnpm run *",
        "cd * && yarn test*",
        "cd * && yarn run *",
        "cd * && bun test*",
        "cd * && node --test*",
        "cd * && npx tsc*",
        "cd * && npx vitest*",
        "cd * && npx jest*",
        "cd * && npx eslint*",
        "cd * && npx prettier*",
        "cd * && npx biome*",
        "cd * && npx playwright test*",
        "cd * && deno check*",
        "cd * && deno lint*",
        "cd * && deno test*",
        "cd * && pytest*",
        "cd * && python -m pytest*",
        "cd * && python3 -m pytest*",
        "cd * && ruff*",
        "cd * && mypy*",
        "cd * && tox*",
        "cd * && uv run pytest*",
        "cd * && uv run ruff*",
        "cd * && uv run mypy*",
        "cd * && poetry run pytest*",
        "cd * && poetry run ruff*",
        "cd * && poetry run mypy*",
        "cd * && go test*",
        "cd * && go build*",
        "cd * && go vet*",
        "cd * && cargo test*",
        "cd * && cargo check*",
        "cd * && cargo clippy*",
        "cd * && cargo build*",
        "cd * && dotnet test*",
        "cd * && dotnet build*",
        "cd * && rspec*",
        "cd * && bundle exec rspec*",
        "cd * && bundle exec rake*",
        "cd * && composer test*",
        "cd * && ./vendor/bin/phpunit*",
        "cd * && make test*",
        "cd * && make check*",
        "cd * && make build*",
        "cd * && make lint*",
        "cd * && npm ci*",
        "cd * && npm install*",
        "cd * && npm audit*",
        "cd * && npm ls*",
        "cd * && npm outdated*",
        "cd * && pnpm install*",
        "cd * && yarn install*",
        "cd * && bun install*",
        "cd * && pip install*",
        "cd * && python -m pip install*",
        "cd * && uv sync*",
        "cd * && poetry install*",
        "cd * && dotnet restore*",
        "cd * && bundle install*",
        "cd * && composer install*",
        "cd * && osv-scanner *",
        "cd * && mvn test*",
        "cd * && mvn verify*",
        "cd * && mvn dependency:tree*",
        "cd * && ./mvnw test*",
        "cd * && ./mvnw verify*",
        "cd * && ./mvnw dependency:tree*",
        "cd * && gradle test*",
        "cd * && gradle check*",
        "cd * && gradle build*",
        "cd * && gradle dependencyInsight*",
        "cd * && ./gradlew test*",
        "cd * && ./gradlew check*",
        "cd * && ./gradlew build*",
        "cd * && ./gradlew dependencyInsight*"
      ]
    },
    {
      "name": "publish",
      "kind": "work",
      "command": "dep-publish",
      "agent": "workflow-dep-publish",
      "prompt": "stages/publish.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git push origin feature/*",
        "git -C * push origin feature/*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "wc *"
      ],
      "platformAllowlist": {
        "github": [
          "gh pr create *",
          "gh pr view*",
          "gh pr list*",
          "gh pr comment *"
        ],
        "ado": []
      },
      "platformTools": {
        "ado": [
          "repo_list_pull_requests_by_repo_or_project",
          "repo_create_pull_request",
          "repo_create_pull_request_thread"
        ]
      }
    }
  ],
  "transitions": {
    "scan": {
      "onPass": {
        "kind": "fire",
        "stage": "upgrade"
      },
      "onFail": {
        "kind": "done",
        "message": "\u2713 Dep sitter done \u2014 the upgrade is already resolved or no longer applies."
      },
      "onError": {
        "kind": "stop",
        "message": "\u2717 Dep sitter stopped \u2014 scan could not read the dependency reports (registry/scanner/environment error). Fix the environment and let the next poll retry."
      }
    },
    "upgrade": {
      "onDone": {
        "kind": "fire",
        "stage": "verify"
      }
    },
    "verify": {
      "onPass": {
        "kind": "fire",
        "stage": "publish"
      },
      "onFail": {
        "kind": "fire",
        "stage": "upgrade",
        "countIteration": true,
        "dropArtifacts": [],
        "capMessage": "\u2717 Dep sitter stopped \u2014 verify failed after {maxIterations} iterations. The attempt is recorded; this upgrade parks until its target version moves or a human takes it over."
      },
      "onError": {
        "kind": "stop",
        "message": "\u2717 Dep sitter stopped \u2014 verify could not run (environment/infrastructure error)."
      }
    },
    "publish": {
      "onDone": {
        "kind": "done",
        "message": "\u2713 Dep sitter done \u2014 pushed the upgrade and opened a draft PR. Merging stays a human call."
      }
    }
  },
  "hooks": {
    "compose": {},
    "validateBeforeTransition": {}
  }
}
