{
  "kind": "dep-sitter",
  "version": 1,
  "description": "Sits on vulnerable and outdated dependencies: confirms the advisory, applies the patch/minor upgrade on a branch, fixes the fallout, verifies the suite is green, and opens a draft PR. Major bumps are never auto-fixed and merging stays a human call.",
  "workSource": {
    "type": "dependency-scan",
    "autoFix": [
      "patch",
      "minor"
    ],
    "severityFloor": "high",
    "includeOutdated": false,
    "ecosystem": "auto"
  },
  "maxIterations": 2,
  "stages": [
    {
      "name": "scan",
      "kind": "check",
      "command": "dep-scan",
      "agent": "workflow-dep-scan",
      "prompt": "stages/scan.md",
      "isolation": "none",
      "bashAllowlist": [
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "npm view *",
        "osv-scanner *",
        "mvn dependency:tree*",
        "mvn * dependency:tree*",
        "mvn help:evaluate*",
        "mvn * help:evaluate*",
        "./mvnw dependency:tree*",
        "./mvnw * dependency:tree*",
        "./mvnw help:evaluate*",
        "./mvnw * help:evaluate*",
        "gradle dependencies*",
        "gradle * dependencies*",
        "gradle *:dependencies*",
        "gradle dependencyInsight*",
        "gradle * dependencyInsight*",
        "gradle *:dependencyInsight*",
        "./gradlew dependencies*",
        "./gradlew * dependencies*",
        "./gradlew *:dependencies*",
        "./gradlew dependencyInsight*",
        "./gradlew * dependencyInsight*",
        "./gradlew *:dependencyInsight*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *"
      ]
    },
    {
      "name": "upgrade",
      "kind": "work",
      "command": "dep-upgrade",
      "agent": "workflow-dep-upgrade",
      "prompt": "stages/upgrade.md",
      "isolation": "worktree"
    },
    {
      "name": "verify",
      "kind": "check",
      "command": "verify",
      "agent": "workflow-verify",
      "prompt": "stages/verify.md",
      "requireEvidence": true,
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "npm -w * test*",
        "npm -w * run *",
        "npm --workspace* test*",
        "npm --workspace* run *",
        "npm --workspaces test*",
        "npm --workspaces run *",
        "pnpm -r test*",
        "pnpm -r run *",
        "pnpm --recursive test*",
        "pnpm --recursive run *",
        "pnpm -F * test*",
        "pnpm -F * run *",
        "pnpm --filter* test*",
        "pnpm --filter* run *",
        "yarn workspace * test*",
        "yarn workspace * run *",
        "yarn workspaces foreach*",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "npx prettier*",
        "npx biome*",
        "npx playwright test*",
        "pnpm exec tsc*",
        "pnpm exec vitest*",
        "pnpm exec jest*",
        "pnpm exec eslint*",
        "pnpm exec prettier*",
        "pnpm exec biome*",
        "pnpm exec playwright test*",
        "pnpm exec next*",
        "npx next*",
        "npx turbo run*",
        "turbo run*",
        "deno check*",
        "deno lint*",
        "deno test*",
        "pytest*",
        "python -m pytest*",
        "python3 -m pytest*",
        "ruff*",
        "mypy*",
        "tox*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run mypy*",
        "poetry run pytest*",
        "poetry run ruff*",
        "poetry run mypy*",
        "go test*",
        "go build*",
        "go vet*",
        "cargo test*",
        "cargo check*",
        "cargo clippy*",
        "cargo build*",
        "dotnet test*",
        "dotnet build*",
        "rspec*",
        "bundle exec rspec*",
        "bundle exec rake*",
        "composer test*",
        "./vendor/bin/phpunit*",
        "make test*",
        "make check*",
        "make build*",
        "make lint*",
        "npm ci*",
        "npm install*",
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "pnpm install*",
        "yarn install*",
        "bun install*",
        "pip install*",
        "python -m pip install*",
        "uv sync*",
        "poetry install*",
        "dotnet restore*",
        "bundle install*",
        "composer install*",
        "osv-scanner *",
        "mvn compile*",
        "mvn * compile*",
        "mvn test*",
        "mvn * test*",
        "mvn package*",
        "mvn * package*",
        "mvn verify*",
        "mvn * verify*",
        "mvn install*",
        "mvn * install*",
        "mvn dependency:tree*",
        "mvn * dependency:tree*",
        "./mvnw compile*",
        "./mvnw * compile*",
        "./mvnw test*",
        "./mvnw * test*",
        "./mvnw package*",
        "./mvnw * package*",
        "./mvnw verify*",
        "./mvnw * verify*",
        "./mvnw install*",
        "./mvnw * install*",
        "./mvnw dependency:tree*",
        "./mvnw * dependency:tree*",
        "gradle test*",
        "gradle * test*",
        "gradle *:test*",
        "gradle check*",
        "gradle * check*",
        "gradle *:check*",
        "gradle build*",
        "gradle * build*",
        "gradle *:build*",
        "gradle dependencyInsight*",
        "gradle * dependencyInsight*",
        "gradle *:dependencyInsight*",
        "./gradlew test*",
        "./gradlew * test*",
        "./gradlew *:test*",
        "./gradlew check*",
        "./gradlew * check*",
        "./gradlew *:check*",
        "./gradlew build*",
        "./gradlew * build*",
        "./gradlew *:build*",
        "./gradlew dependencyInsight*",
        "./gradlew * dependencyInsight*",
        "./gradlew *:dependencyInsight*"
      ]
    },
    {
      "name": "publish",
      "kind": "work",
      "command": "dep-publish",
      "agent": "workflow-dep-publish",
      "prompt": "stages/publish.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git push origin feature/*",
        "git -C * push origin feature/*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "wc *"
      ],
      "platformAllowlist": {
        "github": [
          "gh pr create *",
          "gh pr view*",
          "gh pr list*",
          "gh pr comment *"
        ],
        "ado": []
      },
      "platformTools": {
        "ado": [
          "repo_list_pull_requests_by_repo_or_project",
          "repo_create_pull_request",
          "repo_create_pull_request_thread"
        ]
      }
    }
  ],
  "transitions": {
    "scan": {
      "onPass": {
        "kind": "fire",
        "stage": "upgrade"
      },
      "onFail": {
        "kind": "done",
        "message": "\u2713 Dep sitter done \u2014 the upgrade is already resolved or no longer applies."
      },
      "onError": {
        "kind": "stop",
        "message": "\u2717 Dep sitter stopped \u2014 scan could not read the dependency reports (registry/scanner/environment error). Fix the environment and let the next poll retry."
      }
    },
    "upgrade": {
      "onDone": {
        "kind": "fire",
        "stage": "verify"
      }
    },
    "verify": {
      "onPass": {
        "kind": "fire",
        "stage": "publish"
      },
      "onFail": {
        "kind": "fire",
        "stage": "upgrade",
        "countIteration": true,
        "dropArtifacts": [],
        "capMessage": "\u2717 Dep sitter stopped \u2014 verify failed after {maxIterations} iterations. The attempt is recorded; this upgrade parks until its target version moves or a human takes it over."
      },
      "onError": {
        "kind": "stop",
        "message": "\u2717 Dep sitter stopped \u2014 verify could not run (environment/infrastructure error)."
      }
    },
    "publish": {
      "onDone": {
        "kind": "done",
        "message": "\u2713 Dep sitter done \u2014 pushed the upgrade and opened a draft PR. Merging stays a human call."
      }
    }
  },
  "hooks": {
    "compose": {},
    "validateBeforeTransition": {}
  }
}
