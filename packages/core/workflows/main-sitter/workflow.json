{
  "kind": "main-sitter",
  "version": 1,
  "description": "Sits on the default branch's CI: when it goes red, diagnoses the failure on that exact head (bisecting when needed), writes a verified forward fix or revert, and opens a draft remedy PR \u2014 commenting once on the culprit PR. Never pushes the watched branch; merging stays a human call.",
  "workSource": {
    "type": "ci-runs",
    "workflows": []
  },
  "maxIterations": 2,
  "stages": [
    {
      "name": "diagnose",
      "kind": "check",
      "command": "main-diagnose",
      "agent": "workflow-main-diagnose",
      "prompt": "stages/diagnose.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git bisect*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * bisect*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm ci*",
        "npm install*",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "pytest*",
        "go test*",
        "cargo test*",
        "make test*",
        "make check*"
      ],
      "platformAllowlist": {
        "github": [
          "gh run view*",
          "gh run list*",
          "gh pr list*",
          "gh pr view*"
        ],
        "ado": []
      },
      "platformTools": {
        "ado": [
          "pipelines_get_builds",
          "pipelines_get_build_status",
          "pipelines_get_build_log",
          "pipelines_get_build_log_by_id",
          "repo_list_pull_requests_by_commits"
        ]
      }
    },
    {
      "name": "remedy",
      "kind": "work",
      "command": "main-remedy",
      "agent": "workflow-main-remedy",
      "prompt": "stages/remedy.md",
      "isolation": "worktree"
    },
    {
      "name": "verify",
      "kind": "check",
      "command": "verify",
      "agent": "workflow-verify",
      "prompt": "stages/verify.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "npx prettier*",
        "npx biome*",
        "npx playwright test*",
        "deno check*",
        "deno lint*",
        "deno test*",
        "pytest*",
        "python -m pytest*",
        "python3 -m pytest*",
        "ruff*",
        "mypy*",
        "tox*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run mypy*",
        "poetry run pytest*",
        "poetry run ruff*",
        "poetry run mypy*",
        "go test*",
        "go build*",
        "go vet*",
        "cargo test*",
        "cargo check*",
        "cargo clippy*",
        "cargo build*",
        "dotnet test*",
        "dotnet build*",
        "rspec*",
        "bundle exec rspec*",
        "bundle exec rake*",
        "composer test*",
        "./vendor/bin/phpunit*",
        "make test*",
        "make check*",
        "make build*",
        "make lint*",
        "npm ci*",
        "npm install*",
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "pnpm install*",
        "yarn install*",
        "bun install*",
        "pip install*",
        "python -m pip install*",
        "uv sync*",
        "poetry install*",
        "dotnet restore*",
        "bundle install*",
        "composer install*",
        "osv-scanner *",
        "mvn test*",
        "mvn verify*",
        "mvn dependency:tree*",
        "./mvnw test*",
        "./mvnw verify*",
        "./mvnw dependency:tree*",
        "gradle test*",
        "gradle check*",
        "gradle build*",
        "gradle dependencyInsight*",
        "./gradlew test*",
        "./gradlew check*",
        "./gradlew build*",
        "./gradlew dependencyInsight*"
      ]
    },
    {
      "name": "publish",
      "kind": "work",
      "command": "main-publish",
      "agent": "workflow-main-publish",
      "prompt": "stages/publish.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git push origin main-sitter/*",
        "git -C * push origin main-sitter/*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "wc *"
      ],
      "platformAllowlist": {
        "github": [
          "gh pr create *",
          "gh pr view*",
          "gh pr list*",
          "gh pr comment *"
        ],
        "ado": []
      },
      "platformTools": {
        "ado": [
          "repo_list_pull_requests_by_repo_or_project",
          "repo_create_pull_request",
          "repo_create_pull_request_thread"
        ]
      }
    }
  ],
  "transitions": {
    "diagnose": {
      "onPass": {
        "kind": "fire",
        "stage": "remedy"
      },
      "onFail": {
        "kind": "done",
        "message": "\u2713 Main sitter done \u2014 the failure is a flake or the branch already recovered; no remedy needed."
      },
      "onError": {
        "kind": "stop",
        "message": "\u2717 Main sitter stopped \u2014 diagnose could not reproduce or inspect the failure (environment error). Fix the environment and let the next poll retry."
      }
    },
    "remedy": {
      "onDone": {
        "kind": "fire",
        "stage": "verify"
      }
    },
    "verify": {
      "onPass": {
        "kind": "fire",
        "stage": "publish"
      },
      "onFail": {
        "kind": "fire",
        "stage": "remedy",
        "countIteration": true,
        "dropArtifacts": [],
        "capMessage": "\u2717 Main sitter stopped \u2014 verify failed after {maxIterations} iterations; prefer the revert path. The attempt is recorded; this head parks until a new push replaces it."
      },
      "onError": {
        "kind": "stop",
        "message": "\u2717 Main sitter stopped \u2014 verify could not run (environment/infrastructure error)."
      }
    },
    "publish": {
      "onDone": {
        "kind": "done",
        "message": "\u2713 Main sitter done \u2014 pushed the remedy and opened a draft PR. The watched branch was never touched; merging stays a human call."
      }
    }
  },
  "hooks": {
    "compose": {},
    "validateBeforeTransition": {}
  }
}
