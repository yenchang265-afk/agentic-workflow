{
  "kind": "recurring",
  "version": 1,
  "description": "Repeat a human-authored work order on its own schedule: plan, build, verify, review and publish one cycle unattended, then wait for the next occurrence.",
  "workSource": {
    "type": "recurring-task"
  },
  "maxIterations": 2,
  "stages": [
    {
      "name": "plan",
      "kind": "work",
      "command": "recurring-plan",
      "agent": "workflow-recurring-plan",
      "prompt": "stages/plan.md",
      "planContract": true,
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *"
      ]
    },
    {
      "name": "build",
      "kind": "work",
      "command": "recurring-build",
      "agent": "workflow-recurring-build",
      "prompt": "stages/build.md",
      "isolation": "worktree"
    },
    {
      "name": "verify",
      "kind": "check",
      "command": "verify",
      "agent": "workflow-verify",
      "prompt": "stages/verify.md",
      "requireEvidence": true,
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "npm -w * test*",
        "npm -w * run *",
        "npm --workspace* test*",
        "npm --workspace* run *",
        "npm --workspaces test*",
        "npm --workspaces run *",
        "pnpm -r test*",
        "pnpm -r run *",
        "pnpm --recursive test*",
        "pnpm --recursive run *",
        "pnpm -F * test*",
        "pnpm -F * run *",
        "pnpm --filter* test*",
        "pnpm --filter* run *",
        "yarn workspace * test*",
        "yarn workspace * run *",
        "yarn workspaces foreach*",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "npx prettier*",
        "npx biome*",
        "npx playwright test*",
        "pnpm exec tsc*",
        "pnpm exec vitest*",
        "pnpm exec jest*",
        "pnpm exec eslint*",
        "pnpm exec prettier*",
        "pnpm exec biome*",
        "pnpm exec playwright test*",
        "pnpm exec next*",
        "npx next*",
        "npx turbo run*",
        "turbo run*",
        "deno check*",
        "deno lint*",
        "deno test*",
        "pytest*",
        "python -m pytest*",
        "python3 -m pytest*",
        "ruff*",
        "mypy*",
        "tox*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run mypy*",
        "poetry run pytest*",
        "poetry run ruff*",
        "poetry run mypy*",
        "go test*",
        "go build*",
        "go vet*",
        "cargo test*",
        "cargo check*",
        "cargo clippy*",
        "cargo build*",
        "dotnet test*",
        "dotnet build*",
        "rspec*",
        "bundle exec rspec*",
        "bundle exec rake*",
        "composer test*",
        "./vendor/bin/phpunit*",
        "make test*",
        "make check*",
        "make build*",
        "make lint*",
        "npm ci*",
        "npm install*",
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "pnpm install*",
        "yarn install*",
        "bun install*",
        "pip install*",
        "python -m pip install*",
        "uv sync*",
        "poetry install*",
        "dotnet restore*",
        "bundle install*",
        "composer install*",
        "osv-scanner *",
        "mvn compile*",
        "mvn * compile*",
        "mvn test*",
        "mvn * test*",
        "mvn package*",
        "mvn * package*",
        "mvn verify*",
        "mvn * verify*",
        "mvn install*",
        "mvn * install*",
        "mvn dependency:tree*",
        "mvn * dependency:tree*",
        "./mvnw compile*",
        "./mvnw * compile*",
        "./mvnw test*",
        "./mvnw * test*",
        "./mvnw package*",
        "./mvnw * package*",
        "./mvnw verify*",
        "./mvnw * verify*",
        "./mvnw install*",
        "./mvnw * install*",
        "./mvnw dependency:tree*",
        "./mvnw * dependency:tree*",
        "gradle test*",
        "gradle * test*",
        "gradle *:test*",
        "gradle check*",
        "gradle * check*",
        "gradle *:check*",
        "gradle build*",
        "gradle * build*",
        "gradle *:build*",
        "gradle dependencyInsight*",
        "gradle * dependencyInsight*",
        "gradle *:dependencyInsight*",
        "./gradlew test*",
        "./gradlew * test*",
        "./gradlew *:test*",
        "./gradlew check*",
        "./gradlew * check*",
        "./gradlew *:check*",
        "./gradlew build*",
        "./gradlew * build*",
        "./gradlew *:build*",
        "./gradlew dependencyInsight*",
        "./gradlew * dependencyInsight*",
        "./gradlew *:dependencyInsight*"
      ]
    },
    {
      "name": "review",
      "kind": "check",
      "command": "recurring-review",
      "agent": "workflow-recurring-review",
      "prompt": "stages/review.md",
      "isolation": "worktree",
      "requiredAxes": [
        "correctness",
        "readability",
        "architecture",
        "security",
        "performance"
      ],
      "requireEvidence": true,
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *"
      ]
    },
    {
      "name": "publish",
      "kind": "work",
      "command": "recurring-publish",
      "agent": "workflow-recurring-publish",
      "prompt": "stages/publish.md",
      "isolation": "worktree",
      "bashAllowlist": [
        "git push origin recurring/*",
        "git -C * push origin recurring/*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "wc *"
      ],
      "platformAllowlist": {
        "github": [
          "gh pr create *",
          "gh pr view*",
          "gh pr list*",
          "gh pr comment *"
        ],
        "ado": []
      },
      "platformTools": {
        "ado": [
          "repo_list_pull_requests_by_repo_or_project",
          "repo_create_pull_request",
          "repo_create_pull_request_thread"
        ]
      }
    }
  ],
  "transitions": {
    "plan": {
      "onDone": {
        "kind": "fire",
        "stage": "build"
      }
    },
    "build": {
      "onDone": {
        "kind": "fire",
        "stage": "verify"
      }
    },
    "verify": {
      "onPass": {
        "kind": "fire",
        "stage": "review"
      },
      "onFail": {
        "kind": "fire",
        "stage": "build",
        "countIteration": true,
        "dropArtifacts": [],
        "capMessage": "✗ Recurring cycle stopped — verify failed after {maxIterations} iterations. The attempt is recorded; this definition runs again at its next scheduled occurrence."
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Recurring cycle stopped — verify could not run (environment/infrastructure error). Fix the environment; the next poll retries."
      }
    },
    "review": {
      "onPass": {
        "kind": "fire",
        "stage": "publish"
      },
      "onFail": {
        "kind": "fire",
        "stage": "build",
        "countIteration": true,
        "dropArtifacts": [],
        "capMessage": "✗ Recurring cycle stopped — review failed after {maxIterations} iterations. The attempt is recorded; this definition runs again at its next scheduled occurrence."
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Recurring cycle stopped — review could not run (environment/infrastructure error). Fix the environment; the next poll retries."
      }
    },
    "publish": {
      "onDone": {
        "kind": "done",
        "message": "✓ Recurring cycle done — pushed the branch and opened a draft PR. Merging stays a human call; the definition runs again on its schedule."
      }
    }
  },
  "hooks": {
    "compose": {},
    "validateBeforeTransition": {}
  }
}
