{
  "kind": "engineering",
  "version": 1,
  "description": "The engineering workflow: PLAN (park at the human plan gate) then BUILD → VERIFY → REVIEW over the docs/tasks backlog.",
  "workSource": {
    "type": "backlog",
    "statuses": [
      "draft",
      "queued",
      "plan-review",
      "in-progress",
      "in-review",
      "completed",
      "abandoned"
    ],
    "humanGates": ["draft"],
    "pools": [
      {
        "status": "in-progress",
        "entryStage": "build",
        "claimPredicate": "engineering.isClaimable"
      },
      {
        "status": "queued",
        "entryStage": "plan"
      }
    ]
  },
  "stages": [
    {
      "name": "plan",
      "kind": "work",
      "command": "plan-task",
      "agent": "workflow-plan-author",
      "prompt": "stages/plan.md",
      "planContract": true,
      "isolation": "none"
    },
    {
      "name": "build",
      "kind": "work",
      "command": "build",
      "agent": "workflow-build",
      "prompt": "stages/build.md",
      "isolation": "worktree"
    },
    {
      "name": "verify",
      "kind": "check",
      "command": "verify",
      "agent": "workflow-verify",
      "prompt": "stages/verify.md",
      "requireEvidence": true,
      "discoverChecks": true,
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "npm -w * test*",
        "npm -w * run *",
        "npm --workspace* test*",
        "npm --workspace* run *",
        "npm --workspaces test*",
        "npm --workspaces run *",
        "pnpm -r test*",
        "pnpm -r run *",
        "pnpm --recursive test*",
        "pnpm --recursive run *",
        "pnpm -F * test*",
        "pnpm -F * run *",
        "pnpm --filter* test*",
        "pnpm --filter* run *",
        "yarn workspace * test*",
        "yarn workspace * run *",
        "yarn workspaces foreach*",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "npx prettier*",
        "npx biome*",
        "npx playwright test*",
        "pnpm exec tsc*",
        "pnpm exec vitest*",
        "pnpm exec jest*",
        "pnpm exec eslint*",
        "pnpm exec prettier*",
        "pnpm exec biome*",
        "pnpm exec playwright test*",
        "pnpm exec next*",
        "npx next*",
        "npx turbo run*",
        "turbo run*",
        "deno check*",
        "deno lint*",
        "deno test*",
        "pytest*",
        "python -m pytest*",
        "python3 -m pytest*",
        "ruff*",
        "mypy*",
        "tox*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run mypy*",
        "poetry run pytest*",
        "poetry run ruff*",
        "poetry run mypy*",
        "go test*",
        "go build*",
        "go vet*",
        "cargo test*",
        "cargo check*",
        "cargo clippy*",
        "cargo build*",
        "dotnet test*",
        "dotnet build*",
        "rspec*",
        "bundle exec rspec*",
        "bundle exec rake*",
        "composer test*",
        "./vendor/bin/phpunit*",
        "make test*",
        "make check*",
        "make build*",
        "make lint*",
        "npm ci*",
        "npm install*",
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "pnpm install*",
        "yarn install*",
        "bun install*",
        "pip install*",
        "python -m pip install*",
        "uv sync*",
        "poetry install*",
        "dotnet restore*",
        "bundle install*",
        "composer install*",
        "osv-scanner *",
        "mvn compile*",
        "mvn * compile*",
        "mvn test*",
        "mvn * test*",
        "mvn package*",
        "mvn * package*",
        "mvn verify*",
        "mvn * verify*",
        "mvn install*",
        "mvn * install*",
        "mvn dependency:tree*",
        "mvn * dependency:tree*",
        "./mvnw compile*",
        "./mvnw * compile*",
        "./mvnw test*",
        "./mvnw * test*",
        "./mvnw package*",
        "./mvnw * package*",
        "./mvnw verify*",
        "./mvnw * verify*",
        "./mvnw install*",
        "./mvnw * install*",
        "./mvnw dependency:tree*",
        "./mvnw * dependency:tree*",
        "gradle test*",
        "gradle * test*",
        "gradle *:test*",
        "gradle check*",
        "gradle * check*",
        "gradle *:check*",
        "gradle build*",
        "gradle * build*",
        "gradle *:build*",
        "gradle dependencyInsight*",
        "gradle * dependencyInsight*",
        "gradle *:dependencyInsight*",
        "./gradlew test*",
        "./gradlew * test*",
        "./gradlew *:test*",
        "./gradlew check*",
        "./gradlew * check*",
        "./gradlew *:check*",
        "./gradlew build*",
        "./gradlew * build*",
        "./gradlew *:build*",
        "./gradlew dependencyInsight*",
        "./gradlew * dependencyInsight*",
        "./gradlew *:dependencyInsight*"
      ]
    },
    {
      "name": "review",
      "kind": "check",
      "command": "review",
      "agent": "workflow-review",
      "prompt": "stages/review.md",
      "isolation": "worktree",
      "requiredAxes": ["correctness", "readability", "architecture", "security", "performance"],
      "requireEvidence": true,
      "requireDiffEvidence": true,
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *"
      ]
    }
  ],
  "transitions": {
    "plan": {
      "onDone": {
        "kind": "park",
        "toStatus": "plan-review",
        "message": "Plan written — parked in plan-review/ for human review. Approve with /agentic-workflow:engineering approve."
      }
    },
    "build": {
      "onDone": {
        "kind": "fire",
        "stage": "verify"
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Workflow stopped — BUILD reports the approved plan cannot be implemented as written. Send it back to the PLAN stage with /agentic-workflow:engineering replan <id>."
      }
    },
    "verify": {
      "onPass": {
        "kind": "fire",
        "stage": "review"
      },
      "onFail": {
        "kind": "fire",
        "stage": "build",
        "countIteration": true,
        "capMessage": "✗ Workflow stopped — verify failed after {maxIterations} iterations. If the plan itself is wrong, send it back to the PLAN stage with /agentic-workflow:engineering replan <id>."
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Workflow stopped — verify could not run (environment/infrastructure error). Fix the environment, then /agentic-workflow:engineering recover the task."
      }
    },
    "review": {
      "onPass": {
        "kind": "done",
        "toStatus": "in-review",
        "message": "✓ Workflow done — review passed. Ship it yourself."
      },
      "onFail": {
        "kind": "fire",
        "stage": "build",
        "countIteration": true,
        "dropArtifacts": [
          "verify"
        ],
        "capMessage": "✗ Workflow stopped — review failed after {maxIterations} iterations. If the plan itself is wrong, send it back to the PLAN stage with /agentic-workflow:engineering replan <id>."
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Workflow stopped — review could not run (environment/infrastructure error). Fix the environment, then /agentic-workflow:engineering recover the task."
      }
    }
  },
  "hooks": {
    "compose": {},
    "validateBeforeTransition": {
      "plan": "engineering.planLandedOnDisk"
    }
  }
}
