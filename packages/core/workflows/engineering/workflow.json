{
  "kind": "engineering",
  "version": 1,
  "description": "The engineering workflow: PLAN (park at the human plan gate) then BUILD → VERIFY → REVIEW over the docs/tasks backlog.",
  "workSource": {
    "type": "backlog",
    "statuses": [
      "draft",
      "queued",
      "plan-review",
      "in-progress",
      "in-review",
      "completed",
      "abandoned"
    ],
    "humanGates": ["draft"],
    "pools": [
      {
        "status": "in-progress",
        "entryStage": "build",
        "claimPredicate": "engineering.isClaimable"
      },
      {
        "status": "queued",
        "entryStage": "plan"
      }
    ]
  },
  "stages": [
    {
      "name": "plan",
      "kind": "work",
      "command": "plan-task",
      "agent": "workflow-plan-author",
      "prompt": "stages/plan.md",
      "planContract": true,
      "isolation": "none"
    },
    {
      "name": "build",
      "kind": "work",
      "command": "build",
      "agent": "workflow-build",
      "prompt": "stages/build.md",
      "isolation": "worktree"
    },
    {
      "name": "verify",
      "kind": "check",
      "command": "verify",
      "agent": "workflow-verify",
      "prompt": "stages/verify.md",
      "requireEvidence": true,
      "isolation": "worktree",
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *",
        "npm test*",
        "npm run *",
        "pnpm test*",
        "pnpm run *",
        "yarn test*",
        "yarn run *",
        "bun test*",
        "node --test*",
        "npx tsc*",
        "npx vitest*",
        "npx jest*",
        "npx eslint*",
        "npx prettier*",
        "npx biome*",
        "npx playwright test*",
        "deno check*",
        "deno lint*",
        "deno test*",
        "pytest*",
        "python -m pytest*",
        "python3 -m pytest*",
        "ruff*",
        "mypy*",
        "tox*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run mypy*",
        "poetry run pytest*",
        "poetry run ruff*",
        "poetry run mypy*",
        "go test*",
        "go build*",
        "go vet*",
        "cargo test*",
        "cargo check*",
        "cargo clippy*",
        "cargo build*",
        "dotnet test*",
        "dotnet build*",
        "rspec*",
        "bundle exec rspec*",
        "bundle exec rake*",
        "composer test*",
        "./vendor/bin/phpunit*",
        "make test*",
        "make check*",
        "make build*",
        "make lint*",
        "npm ci*",
        "npm install*",
        "npm audit*",
        "npm ls*",
        "npm outdated*",
        "pnpm install*",
        "yarn install*",
        "bun install*",
        "pip install*",
        "python -m pip install*",
        "uv sync*",
        "poetry install*",
        "dotnet restore*",
        "bundle install*",
        "composer install*",
        "osv-scanner *",
        "mvn test*",
        "mvn verify*",
        "mvn dependency:tree*",
        "./mvnw test*",
        "./mvnw verify*",
        "./mvnw dependency:tree*",
        "gradle test*",
        "gradle check*",
        "gradle build*",
        "gradle dependencyInsight*",
        "./gradlew test*",
        "./gradlew check*",
        "./gradlew build*",
        "./gradlew dependencyInsight*",
        "cd * && npm test*",
        "cd * && npm run *",
        "cd * && pnpm test*",
        "cd * && pnpm run *",
        "cd * && yarn test*",
        "cd * && yarn run *",
        "cd * && bun test*",
        "cd * && node --test*",
        "cd * && npx tsc*",
        "cd * && npx vitest*",
        "cd * && npx jest*",
        "cd * && npx eslint*",
        "cd * && npx prettier*",
        "cd * && npx biome*",
        "cd * && npx playwright test*",
        "cd * && deno check*",
        "cd * && deno lint*",
        "cd * && deno test*",
        "cd * && pytest*",
        "cd * && python -m pytest*",
        "cd * && python3 -m pytest*",
        "cd * && ruff*",
        "cd * && mypy*",
        "cd * && tox*",
        "cd * && uv run pytest*",
        "cd * && uv run ruff*",
        "cd * && uv run mypy*",
        "cd * && poetry run pytest*",
        "cd * && poetry run ruff*",
        "cd * && poetry run mypy*",
        "cd * && go test*",
        "cd * && go build*",
        "cd * && go vet*",
        "cd * && cargo test*",
        "cd * && cargo check*",
        "cd * && cargo clippy*",
        "cd * && cargo build*",
        "cd * && dotnet test*",
        "cd * && dotnet build*",
        "cd * && rspec*",
        "cd * && bundle exec rspec*",
        "cd * && bundle exec rake*",
        "cd * && composer test*",
        "cd * && ./vendor/bin/phpunit*",
        "cd * && make test*",
        "cd * && make check*",
        "cd * && make build*",
        "cd * && make lint*",
        "cd * && npm ci*",
        "cd * && npm install*",
        "cd * && npm audit*",
        "cd * && npm ls*",
        "cd * && npm outdated*",
        "cd * && pnpm install*",
        "cd * && yarn install*",
        "cd * && bun install*",
        "cd * && pip install*",
        "cd * && python -m pip install*",
        "cd * && uv sync*",
        "cd * && poetry install*",
        "cd * && dotnet restore*",
        "cd * && bundle install*",
        "cd * && composer install*",
        "cd * && osv-scanner *",
        "cd * && mvn test*",
        "cd * && mvn verify*",
        "cd * && mvn dependency:tree*",
        "cd * && ./mvnw test*",
        "cd * && ./mvnw verify*",
        "cd * && ./mvnw dependency:tree*",
        "cd * && gradle test*",
        "cd * && gradle check*",
        "cd * && gradle build*",
        "cd * && gradle dependencyInsight*",
        "cd * && ./gradlew test*",
        "cd * && ./gradlew check*",
        "cd * && ./gradlew build*",
        "cd * && ./gradlew dependencyInsight*"
      ]
    },
    {
      "name": "review",
      "kind": "check",
      "command": "review",
      "agent": "workflow-review",
      "prompt": "stages/review.md",
      "isolation": "worktree",
      "requiredAxes": ["correctness", "readability", "architecture", "security", "performance"],
      "requireEvidence": true,
      "bashAllowlist": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git blame*",
        "git -C * status*",
        "git -C * diff*",
        "git -C * log*",
        "git -C * show*",
        "git -C * blame*",
        "ls*",
        "cat *",
        "head *",
        "tail *",
        "grep *",
        "find *",
        "wc *"
      ]
    }
  ],
  "transitions": {
    "plan": {
      "onDone": {
        "kind": "park",
        "toStatus": "plan-review",
        "message": "Plan written — parked in plan-review/ for human review. Approve with /agentic-workflow:engineering approve."
      }
    },
    "build": {
      "onDone": {
        "kind": "fire",
        "stage": "verify"
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Workflow stopped — BUILD reports the approved plan cannot be implemented as written. Send it back to the PLAN stage with /agentic-workflow:engineering replan <id>."
      }
    },
    "verify": {
      "onPass": {
        "kind": "fire",
        "stage": "review"
      },
      "onFail": {
        "kind": "fire",
        "stage": "build",
        "countIteration": true,
        "dropArtifacts": [
          "review"
        ],
        "capMessage": "✗ Workflow stopped — verify failed after {maxIterations} iterations. If the plan itself is wrong, send it back to the PLAN stage with /agentic-workflow:engineering replan <id>."
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Workflow stopped — verify could not run (environment/infrastructure error). Fix the environment, then /agentic-workflow:engineering recover the task."
      }
    },
    "review": {
      "onPass": {
        "kind": "done",
        "toStatus": "in-review",
        "message": "✓ Workflow done — review passed. Ship it yourself."
      },
      "onFail": {
        "kind": "fire",
        "stage": "build",
        "countIteration": true,
        "dropArtifacts": [
          "verify"
        ],
        "capMessage": "✗ Workflow stopped — review failed after {maxIterations} iterations. If the plan itself is wrong, send it back to the PLAN stage with /agentic-workflow:engineering replan <id>."
      },
      "onError": {
        "kind": "stop",
        "message": "✗ Workflow stopped — review could not run (environment/infrastructure error). Fix the environment, then /agentic-workflow:engineering recover the task."
      }
    }
  },
  "hooks": {
    "compose": {},
    "validateBeforeTransition": {
      "plan": "engineering.planLandedOnDisk"
    }
  }
}
